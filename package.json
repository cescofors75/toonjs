{
  "name": "@cescofors/toonjs",
  "version": "1.1.1",
  "description": "High-performance TypeScript library for tabular data manipulation with 100+ optimized methods. Powered by Float64Array Columnar Architecture. Zero dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm run test",
    "lint": "eslint *.ts",
    "format": "prettier --write *.ts",
    "build:wasm:rust": "RUSTFLAGS=\"-C target-feature=+simd128\" cargo build --manifest-path core/Cargo.toml --target wasm32-unknown-unknown --release",
    "build:wasm:opt": "wasm-opt -Oz -all core/target/wasm32-unknown-unknown/release/toon_core.wasm -o core/target/wasm32-unknown-unknown/release/toon_core.wasm",
    "build:wasm:embed": "node scripts/embed-wasm.cjs",
    "build:wasm": "npm run build:wasm:rust && npm run build:wasm:opt && npm run build:wasm:embed",
    "bench:wasm": "ts-node benchmark-wasm.ts",
    "start": "npx serve ."
  },
  "keywords": [
    "typescript",
    "data",
    "tabular",
    "analysis",
    "statistics",
    "dataframe",
    "etl",
    "pipeline",
    "performance",
    "toon",
    "manipulation",
    "aggregation",
    "correlation",
    "timeseries",
    "ranking"
  ],
  "author": "Cesco",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cescofors75/toonjs.git"
  },
  "bugs": {
    "url": "https://github.com/cescofors75/toonjs/issues"
  },
  "homepage": "https://github.com/cescofors75/toonjs#readme",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "binaryen": "^130.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm/loader.d.ts",
      "default": "./dist/wasm/loader.js"
    }
  }
}
